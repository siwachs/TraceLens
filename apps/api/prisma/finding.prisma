/// FOUND: the check ran and positively shows the thing.
/// NOT_FOUND: the check ran and returned a trustworthy negative. It never proves absence in general.
/// ERROR: the check could not complete (timeout, block, rate limit).
/// UNKNOWN: the check completed but the result is ambiguous.
enum FindingStatus {
    FOUND
    NOT_FOUND
    ERROR
    UNKNOWN
}

/// HIGH: deterministic result computed from the artifact itself, or an exact match on a fetched primary page.
/// MEDIUM: tool-reported match with some verification.
/// LOW: heuristic, name-only match, or anything an LLM suggested (kind HYPOTHESIS).
/// The rule used is recorded in `basis`. Entity-level confidence is computed later, in the merge.
enum FindingConfidence {
    LOW
    MEDIUM
    HIGH
}

model Finding {
    id              String @id @default(uuid())
    investigationId String
    runId           String

    kind        String
    entityType  String?
    entityValue String?

    checkStatus FindingStatus      @default(FOUND)
    confidence  FindingConfidence?
    basis       String?

    source    String
    sourceUrl String?

    dedupeKey  String
    payload    Json
    snapshotId String?

    observedAt DateTime @default(now())
    createdAt  DateTime @default(now())

    run      PipelineRun @relation(fields: [runId, investigationId], references: [id, investigationId], onDelete: Cascade)
    snapshot Snapshot?   @relation(fields: [snapshotId, investigationId], references: [id, investigationId], onDelete: NoAction)

    @@unique([runId, dedupeKey])
    @@index([investigationId, entityType, entityValue])
    @@index([snapshotId])
}
