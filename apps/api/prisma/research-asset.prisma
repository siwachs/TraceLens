model ResearchAsset {
    id              String @id @default(uuid())
    investigationId String

    originalFilename String
    contentType      String
    sizeBytes        BigInt

    storageKey String

    status ResearchAssetStatus @default(UPLOADING)

    sha256        String?
    analysis      Json?
    failureReason String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

    artifacts ResearchAssetArtifact[]
    input     Input?

    @@index([investigationId])
}

enum ResearchAssetStatus {
    UPLOADING
    READY
    PROCESSING
    PROCESSED
    FAILED
}

model ResearchAssetArtifact {
    id              String @id @default(uuid())
    researchAssetId String

    type        String
    storageKey  String
    contentType String
    sizeBytes   BigInt

    createdAt DateTime @default(now())

    researchAsset ResearchAsset @relation(fields: [researchAssetId], references: [id], onDelete: Cascade)

    @@unique([researchAssetId, type])
    @@index([researchAssetId])
}
