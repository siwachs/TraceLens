model ResearchAsset {
    id      String @id @default(uuid(7))
    inputId String @unique

    originalFilename String
    contentType      String
    sizeBytes        BigInt

    storageKey String

    status ResearchAssetStatus @default(UPLOADING)

    sha256        String?
    analysis      Json?
    failureReason String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    input Input @relation(fields: [inputId], references: [id], onDelete: Cascade)

    artifacts ResearchAssetArtifact[]
}

enum ResearchAssetStatus {
    UPLOADING
    READY
    PROCESSING
    PROCESSED
    FAILED
}

model ResearchAssetArtifact {
    id              String @id @default(uuid(7))
    researchAssetId String

    type        String
    storageKey  String
    contentType String
    sizeBytes   BigInt

    createdAt DateTime @default(now())

    researchAsset ResearchAsset @relation(fields: [researchAssetId], references: [id], onDelete: Cascade)

    @@unique([researchAssetId, type])
}
