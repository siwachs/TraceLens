/// ACTIVE: open case. ARCHIVED: closed.
/// "Running" and "awaiting approval" are not stored; they are derived from runs and inputs.
enum InvestigationStatus {
    ACTIVE
    ARCHIVED
}

model Investigation {
    id String @id @default(uuid())

    name   String
    status InvestigationStatus @default(ACTIVE)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    inputs Input[]
}
