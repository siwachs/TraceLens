model Snapshot {
    id              String @id @default(uuid(7))
    investigationId String
    runId           String

    sourceUrl   String
    storageKey  String
    contentType String
    sizeBytes   BigInt
    sha256      String
    httpStatus  Int?

    retrievedAt DateTime @default(now())
    createdAt   DateTime @default(now())

    run      PipelineRun @relation(fields: [runId, investigationId], references: [id, investigationId], onDelete: Cascade)
    findings Finding[]

    @@unique([id, investigationId])
    @@index([runId])
    @@index([investigationId])
}
