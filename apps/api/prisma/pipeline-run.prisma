enum PipelineRunStatus {
    QUEUED
    RUNNING
    SUCCEEDED
    PARTIAL
    FAILED
}

model PipelineRun {
    id              String @id @default(uuid(7))
    investigationId String
    inputId         String

    pipeline      String
    status        PipelineRunStatus @default(QUEUED)
    round         Int               @default(0)
    attempt       Int               @default(0)
    failureReason String?

    startedAt  DateTime?
    finishedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    input Input @relation(fields: [inputId, investigationId], references: [id, investigationId], onDelete: Cascade)

    findings  Finding[]
    snapshots Snapshot[]

    @@unique([inputId, pipeline, round])
    @@unique([id, investigationId])
    @@index([investigationId])
    @@index([status, createdAt])
}
