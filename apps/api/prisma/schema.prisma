generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Investigation {
  id String @id @default(uuid())

  name   String
  status String @default("CREATED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  researchAssets ResearchAsset[]
  inputs         Input[]
  pipelineRuns   PipelineRun[]
}

model ResearchAsset {
  id              String @id @default(uuid())
  investigationId String

  originalFilename String
  contentType      String
  sizeBytes        BigInt

  storageKey String

  status ResearchAssetStatus @default(UPLOADING)

  sha256        String?
  analysis      Json?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  artifacts ResearchAssetArtifact[]
  input     Input?

  @@index([investigationId])
}

enum ResearchAssetStatus {
  UPLOADING
  READY
  PROCESSING
  PROCESSED
  FAILED
}

model ResearchAssetArtifact {
  id              String @id @default(uuid())
  researchAssetId String

  type        String
  storageKey  String
  contentType String
  sizeBytes   BigInt

  createdAt DateTime @default(now())

  researchAsset ResearchAsset @relation(fields: [researchAssetId], references: [id], onDelete: Cascade)

  @@unique([researchAssetId, type])
  @@index([researchAssetId])
}

// Research Input Type
enum InputType {
  IMAGE
  USERNAME
  EMAIL
  PHONE
  URL
  DOMAIN
  NAME
  TEXT
}

enum InputOrigin {
  USER
  DISCOVERED
}

enum InputStatus {
  PROPOSED
  ACTIVE
  ARCHIVED
}

model Input {
  id              String @id @default(uuid())
  investigationId String

  type            InputType
  value           String
  normalizedValue String
  platform        String      @default("")
  origin          InputOrigin @default(USER)
  status          InputStatus @default(ACTIVE)
  note            String?

  researchAssetId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investigation Investigation  @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  researchAsset ResearchAsset? @relation(fields: [researchAssetId], references: [id], onDelete: Cascade)
  pipelineRuns  PipelineRun[]

  @@unique([investigationId, type, platform, normalizedValue])
  @@index([investigationId])
}

// Input PipelineRun
enum PipelineRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model PipelineRun {
  id              String @id @default(uuid())
  investigationId String
  inputId         String

  pipeline      String
  status        PipelineRunStatus @default(QUEUED)
  round         Int               @default(0)
  attempt       Int               @default(0)
  failureReason String?

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  input         Input         @relation(fields: [inputId], references: [id], onDelete: Cascade)

  @@unique([inputId, pipeline, round])
  @@index([investigationId])
  @@index([status, createdAt])
}
