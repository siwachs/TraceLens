generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Investigation {
  id String @id @default(uuid())

  name   String
  status String @default("CREATED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  researchAssets ResearchAsset[]
}

model ResearchAsset {
  id              String @id @default(uuid())
  investigationId String

  originalFilename String
  contentType      String
  sizeBytes        BigInt

  storageKey String

  status ResearchAssetStatus @default(UPLOADING)

  sha256 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  artifacts ResearchAssetArtifact[]

  @@index([investigationId])
}

enum ResearchAssetStatus {
  UPLOADING
  READY
  PROCESSING
  PROCESSED
  FAILED
}

model ResearchAssetArtifact {
  id              String @id @default(uuid())
  researchAssetId String

  type        String
  storageKey  String
  contentType String
  sizeBytes   BigInt

  createdAt DateTime @default(now())

  researchAsset ResearchAsset @relation(fields: [researchAssetId], references: [id], onDelete: Cascade)

  @@index([researchAssetId])
}
