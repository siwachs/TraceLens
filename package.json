{
  "name": "tracelens",
  "private": true,
  "workspaces": [
    "apps/*",
    "infra"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run start:dev",
    "build": "npm run build --workspaces",
    "infra:build": "npm --workspace infra run build",
    "infra:synth": "npm --workspace infra run synth",
    "infra:diff": "npm --workspace infra run diff",
    "infra:deploy": "npm --workspace infra run deploy",
    "infra:destroy": "npm --workspace infra run destroy",
    "infra:bootstrap": "npm --workspace infra run bootstrap"
  }
}
